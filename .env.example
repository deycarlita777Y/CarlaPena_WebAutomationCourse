# Environment selector: loads .env.<TEST_ENV> first, then .env (default: local)
# TEST_ENV=local

# Base URL of the application under test (required)
BASE_URL=https://www.saucedemo.com/

# Test user credentials (saucedemo)
TEST_USER_NAME=standard_user
TEST_USER_PASSWORD=secret_sauce

# Site URLs. Defaults exist only for TEST_ENV=local; any other environment must set them.
AUTOMATION_EXERCISE_URL=https://www.automationexercise.com
DEMOQA_URL=https://demoqa.com

# demoqa accounts are created per worker through the API (no shared account to configure).

# Prefix of generated test data (default qa_)
# TEST_DATA_PREFIX=qa_

# Set to "false" in shared environments to forbid bulk cleanup (default: allowed)
# ALLOW_DESTRUCTIVE_CLEANUP=false
